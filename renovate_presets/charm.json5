{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":noUnscheduledUpdates",
    // Avoid conflicts with custom `commitMessagePrefix`
    ":semanticCommitsDisabled"
  ],
  "schedule": ["after 1am and before 3am every weekday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 1am and before 3am every weekday"]
  },
  "timezone": "Etc/UTC",
  "enabledManagers": ["poetry", "github-actions", "regex"],
  "packageRules": [
    // Later rules override earlier rules
    {
      "matchManagers": ["poetry"],
      "rangeStrategy": "bump",
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": ["charm-libs"],
      "rangeStrategy": "in-range-only",
      "groupName": "Python dependencies"
    },
    // Disable Python updates
    // (Python version should be updated when Ubuntu version is updated)
    {
      "matchManagers": ["poetry"],
      // Renovate uses "dependencies" instead of "main" for top-level dependency group
      "matchDepTypes": ["dependencies"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub actions"
    },
    // Group data-platform-workflows Python package & workflow updates into the same PR
    {
      "matchManagers": ["poetry"],
      "matchPackageNames": ["canonical/data-platform-workflows"],
      // Ensure Renovate prefers vX.0.0 tag (e.g. "v24.0.0") over vX tag (e.g. "v24") if vX.X.X tag
      // currently in use
      // (Matches default versioning of "github-actions" manager)
      "versioning": "docker",
      "groupName": "data-platform-workflows"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["canonical/data-platform-workflows"],
      "groupName": "data-platform-workflows"
    },
    {
      "matchManagers": ["regex"],
      "matchPackageNames": ["juju/juju"],
      "groupName": "Juju agents",
      "separateMinorPatch": true  // Since minor version updates are disabled
    },
    // Disable major & minor version updates for Juju agent (they should be handled manually)
    {
      "matchManagers": ["regex"],
      "matchPackageNames": ["juju/juju"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchManagers": ["regex"],
      "matchPackageNames": ["canonical/microk8s"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "MicroK8s"
    },
    {
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "groupName": "OCI digests"
    },
    // Update build tools in charmcraft.yaml
    {
      "matchManagers": ["regex"],
      "matchDepNames": ["pip", "uv", "python3.10", "poetry", "poetry-plugin-export"],
      "groupName": "charmcraft.yaml build tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$"],
      "matchStrings": ["(?<currentValue>[0-9.]+) +# renovate: juju-agent-pin-minor"],
      "packageNameTemplate": "juju/juju",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    // Update microk8s to latest release
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$"],
      "matchStrings": [
        "(?<currentValue>[0-9.]+)[a-z-]*/[a-z]+ +# renovate: latest microk8s"
      ],
      "packageNameTemplate": "canonical/microk8s",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    // Update rock images
    {
      "customType": "regex",
      "fileMatch": ["^metadata\\.yaml$"],
      "matchStrings": [
        "upstream-source: (?<depName>.*?)@(?<currentDigest>sha256:[0-9a-f]+) +# renovate: oci-image tag: (?<currentValue>.*?)\n"
      ],
      "datasourceTemplate": "docker"
    },
    // Update pip version in charmcraft.yaml
    {
      "customType": "regex",
      "fileMatch": ["^charmcraft\\.yaml$"],
      "matchStrings": ["==(?<currentValue>[^ ]+) +# renovate: charmcraft-pip-latest"],
      "depNameTemplate": "pip",
      "datasourceTemplate": "pypi"
    },
    // Update uv version in charmcraft.yaml
    {
      "customType": "regex",
      "fileMatch": ["^charmcraft\\.yaml$"],
      "matchStrings": ["download\\/(?<currentValue>[^/]+)\\/[^\\n]* # renovate: charmcraft-uv-latest"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    // Update Python version in charmcraft.yaml
    {
      "customType": "regex",
      "fileMatch": ["^charmcraft\\.yaml$"],
      "matchStrings": [" (?<currentValue>[^ ]+) +# renovate: charmcraft-python-ubuntu-22\\.04"],
      // "python3" package does not have the correct Python patch version; use "python3.10" instead
      "depNameTemplate": "python3.10",
      // Remove debian revision from version
      // (https://www.debian.org/doc/debian-policy/ch-controlfields.html#version)
      "extractVersionTemplate": "^(?<version>.+?)(-[^-]*)?$",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://archive.ubuntu.com/ubuntu/?release=jammy&components=main&binaryArch=amd64",
      "versioningTemplate": "semver"
    },
    // Update poetry version in charmcraft.yaml
    {
      "customType": "regex",
      "fileMatch": ["^charmcraft\\.yaml$"],
      "matchStrings": ["poetry==(?<currentValue>[^ ]+)[^\\n]* # renovate: charmcraft-poetry-latest"],
      "depNameTemplate": "poetry",
      "datasourceTemplate": "pypi"
    },
    // Update poetry-plugin-export version in charmcraft.yaml
    {
      "customType": "regex",
      "fileMatch": ["^charmcraft\\.yaml$"],
      "matchStrings": ["poetry-plugin-export==(?<currentValue>[^ ]+)[^\\n]* # renovate: charmcraft-poetry-latest"],
      "depNameTemplate": "poetry-plugin-export",
      "datasourceTemplate": "pypi"
    }
  ]
}
