{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>canonical/data-platform//renovate_presets/base.json5"],
  // Exclude Renovate PRs from auto-generated release notes
  "labels": ["not bug or enhancement"],
  "enabledManagers": ["github-actions", "poetry", "pep621", "custom.regex"],
  "packageRules": [
    // Later rules override earlier rules
    {
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["poetry", "pep621"],
      "rangeStrategy": "bump",
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": ["charm-libs"],
      "rangeStrategy": "in-range-only",
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "in-range-only",
      "matchJsonata": [
          "depType = 'dependency-groups' and managerData.depGroup = 'charm-libs'"
      ],
      "groupName": "Python dependencies"
    },
    // Disable Python updates
    // (Python version should be updated when Ubuntu version is updated)
    {
      "matchManagers": ["poetry"],
      // Renovate uses "dependencies" instead of "main" for top-level dependency group
      "matchDepTypes": ["dependencies"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["juju/juju"],
      "groupName": "Juju agents",
      "separateMinorPatch": true  // Since minor version updates are disabled
    },
    // Disable major & minor version updates for Juju agent (they should be handled manually)
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["juju/juju"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["canonical/microk8s"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "MicroK8s"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "groupName": "OCI digests"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/charmcraft.yaml"],
      "groupName": "charmcraft.yaml build tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?<currentValue>[0-9.]+) +# renovate: juju-agent-pin-minor"
      ],
      "packageNameTemplate": "juju/juju",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    // Update microk8s to latest release
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?<currentValue>[0-9.]+)[a-z-]*/[a-z]+ +# renovate: latest microk8s"
      ],
      "packageNameTemplate": "canonical/microk8s",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    // Update rock images
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)metadata\\.yaml$/"],
      "matchStrings": [
        "upstream-source: (?<depName>.*?)@(?<currentDigest>sha256:[0-9a-f]+) +# renovate: oci-image tag: (?<currentValue>.*?)\n"
      ],
      "datasourceTemplate": "docker"
    },
    // Update pip version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        "==(?<currentValue>[^ ]+) +# renovate: charmcraft-pip-latest"
      ],
      "depNameTemplate": "pip",
      "datasourceTemplate": "pypi"
    },
    // Update uv version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        "download\\/(?<currentValue>[^/]+)\\/[^\\n]* # renovate: charmcraft-uv-latest"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    // Update Python version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        " (?<currentValue>[^ ]+) +# renovate: charmcraft-python-ubuntu-22\\.04"
      ],
      // "python3" package does not have the correct Python patch version; use "python3.10" instead
      "depNameTemplate": "python3.10",
      // Remove debian revision from version
      // (https://www.debian.org/doc/debian-policy/ch-controlfields.html#version)
      "extractVersionTemplate": "^(?<version>.+?)(-[^-]*)?$",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://archive.ubuntu.com/ubuntu/?release=jammy-updates&components=main&binaryArch=amd64",
      "versioningTemplate": "semver"
    },
    // Update poetry version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        "poetry==(?<currentValue>[^ ]+)[^\\n]* # renovate: charmcraft-poetry-latest"
      ],
      "depNameTemplate": "poetry",
      "datasourceTemplate": "pypi"
    },
    // Update poetry-plugin-export version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        "poetry-plugin-export==(?<currentValue>[^ ]+)[^\\n]* # renovate: charmcraft-poetry-latest"
      ],
      "depNameTemplate": "poetry-plugin-export",
      "datasourceTemplate": "pypi"
    },
    // Update rust version in charmcraft.yaml
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)charmcraft\\.yaml$/"],
      "matchStrings": [
        " (?<currentValue>[^ ]+) +# renovate: charmcraft-rust-latest"
      ],
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
